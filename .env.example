# .env.example — COMPASS NLP backend configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the secret values (marked "← REQUIRED").
# Everything else has a working default and can be left as-is for local dev.
#
#     cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# ── Flask ────────────────────────────────────────────────────────────────────
# Use "development" locally to enable the auto-reloading debug server.
FLASK_ENV=development
PORT=5000
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-hex-string
# Comma-separated allowed CORS origins (frontend URLs), no trailing slashes.
FRONTEND_ORIGINS=http://localhost:3000,https://compass-two-iota.vercel.app,https://compaass.vercel.app,https://compass-seven-rho.vercel.app

# ── Emotion model ────────────────────────────────────────────────────────────
# The model is downloaded from HuggingFace by startup.py into MODEL_DIR.
USE_ONNX=true
MODEL_DIR=./distilbert_finetuned
ONNX_MODEL_PATH=./distilbert_finetuned/onnx_model/model_quantized.onnx
LABELS_PATH=./label_classes.json

# ── HuggingFace Hub (model download at startup) ──────────────────────────────
HF_MODEL_REPO=Oheha/compass-emotion-classifier
HF_TOKEN=                          # ← REQUIRED only if the HF repo is private

# ── Groq LLM (empathetic replies + translation) ─────────────────────────────
GROQ_API_KEY=                      # ← REQUIRED for LLM replies; blank = template fallback
GROQ_MODEL=llama-3.1-8b-instant
LANGUAGE_TRANSLATION_PROVIDER=groq
LANGUAGE_TRANSLATION_TIMEOUT_SECONDS=8.0
ENABLE_MULTILINGUAL=true
SUPPORTED_LANGUAGES=en,yo,pcm
LLM_HISTORY_TURNS=6
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_TOKENS=200

# ── MongoDB (optional — conversation persistence) ───────────────────────────
# Leave the default for local Mongo, or paste an Atlas SRV URI. App runs without it.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mental_health_chatbot
MONGO_COLLECTION=conversations

# ── Redis (session state, prediction cache, rate limiting) ──────────────────
# App fails-open (in-process cache) if Redis is unreachable.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
SESSION_TTL_SECONDS=1800
PREDICTION_CACHE_TTL=60

# ── NLP tuning ───────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
CONFIDENCE_THRESHOLD=0.50
MAX_INPUT_LENGTH=512
MAX_RAW_CHARS=1000

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Therapist emergency alerts ───────────────────────────────────────────────
# When a hard crisis is detected, email an on-call therapist. Leave disabled to
# keep current behavior. To enable, set ENABLE_THERAPIST_ALERTS=true and fill in
# the recipient + SMTP settings below.
ENABLE_THERAPIST_ALERTS=false
THERAPIST_ALERT_EMAIL=                 # on-call therapist's email (recipient)
ALERT_EMAIL_FROM=                      # sender address; defaults to SMTP_USERNAME
ALERT_APP_NAME=COMPASS
ALERT_COOLDOWN_SECONDS=900             # max one alert per user per 15 min (0 = no dedupe)

# SMTP transport — works with Gmail, SendGrid SMTP relay, Mailgun, etc.
# Gmail example:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<app password>
# SendGrid example: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USERNAME=apikey SMTP_PASSWORD=<sendgrid api key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0
